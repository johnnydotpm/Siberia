<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable from a one-cell strip to about 5x3 cells; larger sizes would
     only add empty space, so they are not offered. The settings screen is
     optional when placing the widget and can be opened again later. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.syberia.client.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_small"
    android:maxResizeHeight="280dp"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
