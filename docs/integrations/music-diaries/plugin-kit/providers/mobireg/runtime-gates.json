{
  "schema_version": 1,
  "note": "Gates are per operation/field; unrelated verified read work need not wait for unknown write contracts. User authorization required for real account/network mutations. No live request was made.",
  "gates": [
    {
      "id": "G-AUTH",
      "trigger": "Before production login/refresh support",
      "acceptance": "Authorized account fixtures: success, rejected password, expiredJWT, missing/replacement refresh, concurrent sibling-child refresh, and clear owner identity; no claim server revocation without server contract.",
      "status": "open"
    },
    {
      "id": "G-QR",
      "trigger": "Before claiming QR edge-case compatibility",
      "acceptance": "Match Dart Uri normalization, repeated params, malformed percent escapes, path/fragment and code expiry; getter attribution is strong cross-use inference, not decoded dispatch table.",
      "status": "open"
    },
    {
      "id": "G-DISCOVERY",
      "trigger": "Before enabling every role/school",
      "acceptance": "users response with parent multiple children, student self, empty pupil list, missing messagesToken, null/moduleURLs and legitimate tenant boundaries; numeric roles beyond self==1 remain unknown.",
      "status": "open"
    },
    {
      "id": "G-PERIOD",
      "trigger": "Before school-year navigation is production verified",
      "acceptance": "Terms with year and semester hierarchy, invalid/empty dates, school timezone and inclusive end bounds; no September/year assumptions from device date.",
      "status": "open"
    },
    {
      "id": "G-DECODE",
      "trigger": "Before normalizing unresolved fields",
      "acceptance": "Resolve each exact field in unresolved_field_contracts by targeted constructor branch tracing or authorized redacted capture; keep raw value meanwhile.",
      "status": "open"
    },
    {
      "id": "G-ENUM",
      "trigger": "Before user-facing semantic enum labels",
      "acceptance": "Establish actual numeric status, attendance, homework, substitution, entitlement and role meanings; never equate unknown status1 to approved.",
      "status": "open"
    },
    {
      "id": "G-PAGINATION",
      "trigger": "Before mailbox list completion claim",
      "acceptance": "Folder items/total fixtures with offsets, empty intermediate page, search, changed ordering and large totals; verify stopping/deduplication rule.",
      "status": "open"
    },
    {
      "id": "G-MAILWRITE",
      "trigger": "Before sending/deleting/toggling with real accounts",
      "acceptance": "Authorized controlled user-initiated test with recipient category/string-ID fixtures and body success/attachment failure; distinguish auth challenge from uncertain outcome and verify trash/restore semantics.",
      "status": "open"
    },
    {
      "id": "G-HOMEWORKWRITE",
      "trigger": "Before solution/upload capability enabled",
      "acceptance": "Exact solution files reference JSON after upload, upload response shape and limits, per-pupil authorization, archived toggle semantics and confirmed submission statuses.",
      "status": "open"
    },
    {
      "id": "G-POLL",
      "trigger": "Before poll capability production verified",
      "acceptance": "Eligible open/closed/expired/answered/declined polls and accepted/rejected write response with pendingCount; explicit user choice, no automatic votes.",
      "status": "open"
    },
    {
      "id": "G-JUSTIFY",
      "trigger": "Before justification writes production verified",
      "acceptance": "Authorized eligibility/status fixtures including pending/approved/rejected mapping, create/update/delete confirmation and event IDs belonging to chosen child.",
      "status": "open"
    },
    {
      "id": "G-PUSH",
      "trigger": "Before claiming vendor upstream push support",
      "acceptance": "Server compatibility with Siberia-owned Firebase registration, token rotation/unregister and exact notification preferences endpoint; never bundle original Firebase credentials.",
      "status": "open"
    },
    {
      "id": "G-LEGACY",
      "trigger": "Before selecting legacy compatibility mode",
      "acceptance": "Confirm still-supported server endpoint/protocol1.6.0; verify full/delta wrapper/unknown-table/error/tombstone/absent/null handling and exactly server cursor semantics.",
      "status": "open"
    },
    {
      "id": "G-IOS",
      "trigger": "Before asserting cross-platform parity",
      "acceptance": "Independently verify iOS3.1.7 build116 revisiond20dd8d caller paths; Android6f4e7b8 PCs are not iOS evidence.",
      "status": "open"
    },
    {
      "id": "G-FILE",
      "trigger": "Before attachment feature release",
      "acceptance": "Authorized MIME/filename/size constraints and redirected/signedURL scope; file-open cleanup and account-switch races; no credentials to arbitrary file hosts.",
      "status": "open"
    },
    {
      "id": "G-LOCAL",
      "trigger": "Before local parity marked complete",
      "acceptance": "Implement and test61feature mapping across appearance/accessibility/help/cache/support/entitlements plus Android/iOS/desktop flows; library-only teacher row remains excluded.",
      "status": "open"
    }
  ],
